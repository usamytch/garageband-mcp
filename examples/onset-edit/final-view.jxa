noSheet();
Application('GarageBand').activate();delay(.2);
for (const name of ['Library','Smart Controls','Editors']) {
  const hits=scan(window,el=>scalar(el,'AXRole')==='AXCheckBox' && scalar(el,'AXDescription')===name);
  if(hits.length===1 && Number(scalar(hits[0].element,'AXValue'))===1) click(hits[0]);
}
const result=setTimelineZoom(.28);
const scroll=one(scan(window,el=>scalar(el,'AXRole')==='AXScrollBar' && scalar(el,'AXOrientation')==='AXHorizontalOrientation' && bounds(el).size[0]>500),'timeline scroll');
$.AXUIElementSetAttributeValue(scroll.element,$('AXValue'),$(0));
return {zoom:result,scroll:scalar(scroll.element,'AXValue')};
