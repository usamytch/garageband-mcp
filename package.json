{
  "name": "garageband-mcp",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/usamytch/garageband-mcp.git"
  },
  "description": "Local GarageBand MCP: guarded GUI operations, mixing, regions, experimental vocal automation, and genre-aware mixing skills",
  "type": "module",
  "bin": {
    "garageband-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test test-build/test/*.test.js",
    "test:audio": "python3 -m unittest discover -s scripts/audio_edit -p 'test_*.py'",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm test && npm run typecheck && npm run build && npm run smoke",
    "check:all": "npm run check && npm run test:audio",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "garageband",
    "midi",
    "music",
    "macos",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "easymidi": "^3.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  }
}
